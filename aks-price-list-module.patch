+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { parseAksBatch } from '../features/prices/aks/parser.js';
+
+const names = process.argv.slice(2);
+if (!names.length) {
+  console.error('Usage: npm run check:aks -- "path/to/aks-quote.pdf" ["another.pdf"]');
+  process.exit(1);
+}
+const files = await Promise.all(names.map(async name => ({
+  originalname: path.basename(name),
+  buffer: await fs.readFile(name),
+})));
+const parsed = await parseAksBatch(files);
+console.log(JSON.stringify({
+  files: parsed.files,
+  totalItems: parsed.totalItems,
+  ready: parsed.ready,
+  duplicates: parsed.duplicates,
+  warnings: parsed.warnings,
+  sample: parsed.items.slice(0, 12),
+}, null, 2));
+if (!parsed.ready) process.exitCode = 2;
