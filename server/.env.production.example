# Configure in cPanel > Setup Node.js App > Environment Variables.
# Do NOT commit the real values or upload them to public_html.
NODE_ENV=production
CLIENT_ORIGIN=https://your-domain.example
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_db_user
DB_PASSWORD=choose_a_private_database_password
DB_NAME=your_cpanel_db_name
JWT_SECRET=generate_a_random_secret_at_least_32_characters
# Do not set PORT unless your hosting provider requires it.
